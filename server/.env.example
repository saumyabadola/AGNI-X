# ==============================================================================
# AGNI-X Backend - Environment Template
# ==============================================================================
# Copy this file to .env and insert your NASA FIRMS MAP_KEY.
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key
#
# IMPORTANT: This key is stored SERVER-SIDE ONLY and is never sent to the browser.

NASA_FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE

# Server Port
PORT=8000
